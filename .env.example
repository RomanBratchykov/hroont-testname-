# Copy to .env. Environment variables override this file; command-line options override both.
MODEL_PROVIDER=ollama
# Leave empty to use qwen3.5:4b for Ollama or deepseek-flash for DeepSeek.
MODEL_NAME=
OLLAMA_URL=http://127.0.0.1:11434
MODEL_TIMEOUT_SECONDS=120
BUDGET_PHASE=testing

# DeepSeek only. Enter your key and current USD prices per million tokens.
# Use the uncached input price and the maximum applicable output price for your selected model/mode.
DEEPSEEK_API_KEY=
DEEPSEEK_INPUT_USD_PER_MILLION=
DEEPSEEK_OUTPUT_USD_PER_MILLION=

# Optional LibreTranslate-compatible /translate URL (local CPU service preferred).
# Setting an external URL explicitly permits sending Cyrillic input to that service.
TRANSLATION_URL=
TRANSLATION_API_KEY=

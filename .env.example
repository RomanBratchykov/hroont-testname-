# Copy to .env. Environment variables override this file; command-line options override both.

# === Main Backend & Model Provider ===
MODEL_PROVIDER=deepseek
# Launcher uses provider-specific model variables; --model overrides these.
OLLAMA_MODEL=qwen3.5:4b
DEEPSEEK_MODEL=deepseek-flash
OLLAMA_URL=http://127.0.0.1:11434
MODEL_TIMEOUT_SECONDS=120
# DeepSeek active visitor slots (1–10000); additional model turns wait in the queue.
MAX_ACTIVE_USERS=50
# Concurrent model requests per server process (1–64); raise to match backend capacity.
MODEL_CONCURRENCY=4
BUDGET_PHASE=testing

# Hosted DeepSeek API only (not required when OPENAI_BASE_URL points to a local server).
DEEPSEEK_API_KEY=
DEEPSEEK_INPUT_USD_PER_MILLION=
DEEPSEEK_OUTPUT_USD_PER_MILLION=

# Optional LibreTranslate-compatible /translate URL (local CPU service preferred).
# Setting an external URL explicitly permits sending Cyrillic input to that service.
TRANSLATION_URL=
TRANSLATION_API_KEY=

# Output budgets include internal thinking tokens in reasoning mode.
MODEL_MAX_OUTPUT_TOKENS=1024
MODEL_MAX_REASONING_TOKENS=4096

# Optional exact HTTPS origin for a Cloudflare tunnel; no trailing slash.
PUBLIC_ORIGIN=

# === RAG Service Integration ===
# Set to http://127.0.0.1:8001 for the local RAG FastAPI service, or "direct" for in-process retrieval.
RAG_URL=http://127.0.0.1:8001
RAG_PORT=8001
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001

# === PostgreSQL Configuration (RAG Docker Compose) ===
POSTGRES_USER=agro_user
POSTGRES_PASSWORD=agro_password
POSTGRES_DB=kherson_crop_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://agro_user:agro_password@localhost:5432/kherson_crop_db

# === Qdrant Vector DB Configuration (RAG Docker Compose) ===
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=agronomy_knowledge
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# === Local DeepSeek Configuration (OpenAI-compatible API, e.g., Ollama / vLLM / LM Studio) ===
OPENAI_BASE_URL=
OPENAI_API_KEY=
# For local DeepSeek set OPENAI_BASE_URL and DEEPSEEK_MODEL explicitly.

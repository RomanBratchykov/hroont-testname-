# Application Settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001
RAG_PORT=8001
RAG_URL=http://127.0.0.1:8001

# PostgreSQL Configuration
POSTGRES_USER=agro_user
POSTGRES_PASSWORD=agro_password
POSTGRES_DB=kherson_crop_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://agro_user:agro_password@localhost:5432/kherson_crop_db

# Qdrant Vector DB Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
# Required for authenticated Qdrant, including Qdrant Cloud; backend/ingestion only.
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=agronomy_knowledge
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Local DeepSeek Configuration (OpenAI-compatible API, e.g., Ollama / vLLM / LM Studio)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=sk-local-deepseek-dummy-key
DEEPSEEK_MODEL=deepseek-r1:8b

# Optional absolute directory; defaults to RAG/rag/data. Indexing runs explicitly.
# RAG_DATA_DIR=/absolute/path/to/datasets
